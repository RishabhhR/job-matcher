{
  "version": 2,
  "regions": [
    "bom1"
  ],
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "data/**",
          "node_modules/@sparticuz/chromium/bin/**"
        ]
      }
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/server.ts"
    },
    {
      "src": "/jobs",
      "dest": "src/server.ts"
    },
    {
      "src": "/jobs/(.*)",
      "dest": "src/server.ts"
    },
    {
      "src": "/v2",
      "status": 308,
      "headers": {
        "Location": "/v2/"
      }
    },
    {
      "src": "/v2/",
      "dest": "public/v2/index.html"
    },
    {
      "src": "/",
      "dest": "public/v2/index.html"
    },
    {
      "src": "/classic/",
      "status": 308,
      "headers": {
        "Location": "/classic"
      }
    },
    {
      "src": "/classic",
      "dest": "public/index.html"
    },
    {
      "src": "/join",
      "dest": "public/v2/index.html"
    },
    {
      "src": "/sitemap.xml",
      "dest": "src/server.ts"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
